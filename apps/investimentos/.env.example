# Copie para .env e preencha. O .env nunca vai para o git.
DEBUG=true
# SECRET_KEY=troque-em-producao
# Postgres do docker-compose. Sem esta linha, o backend usa SQLite local.
DATABASE_URL=postgres://ledgerlouis:ledgerlouis@localhost:5432/ledgerlouis
# Crie grátis em https://brapi.dev
BRAPI_TOKEN=

# --- Só para publicar no subdomínio (em localhost os padrões bastam) ---
# Domínios que o Django aceita, separados por vírgula. Padrão: localhost,127.0.0.1
# ALLOWED_HOSTS=investimentos.seu-dominio.com
# Origens liberadas no CORS. Padrão: http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://investimentos.seu-dominio.com

# --- Chat com o Gemini ---
# Chave da API do Google: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo do chat. Padrão: gemini-3.5-flash
# GEMINI_CHAT_MODEL=
